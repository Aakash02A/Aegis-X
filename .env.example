# ---- MySQL 8.4 (the only supported database) ----
# For a MySQL you already run on 3306, leave these as they are. If you use the compose database,
# it is published on 3307 to avoid colliding with a host install:
#   DB_URL=jdbc:mysql://localhost:3307/aegisx?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
#
# The URL parameters are not optional:
#   connectionTimeZone=UTC and forceConnectionTimeZoneToSession=true pin the session to UTC, which
#     is what makes DATETIME(6) DEFAULT CURRENT_TIMESTAMP(6) mean UTC. Without them the stored
#     instants shift with the server's zone.
#   useSSL=false / allowPublicKeyRetrieval=true are for a local server only. Both must be removed
#     for anything reachable over a network, and the password must be set.
DB_URL=jdbc:mysql://localhost:3306/aegisx?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8&useSSL=false&allowPublicKeyRetrieval=true
DB_NAME=aegisx
DB_USERNAME=root
DB_PASSWORD=
# Local-only signing key — MUST be replaced before any non-local deployment.
# ??  This placeholder is publicly known. The prod profile refuses to start if this exact value
#    is detected, or if the secret is shorter than 32 bytes (ProductionSafetyChecks.java).
# Generate a secure key:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_replace_with_openssl_rand_base64_48
JWT_EXPIRATION=86400000
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_ENDPOINT=https://graph.facebook.com/v26.0
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_NOTIFICATION_TEMPLATE=notification
WHATSAPP_DOCUMENT_REQUEST_TEMPLATE=document_request


# ---- Payment integrity engine (Aegis-X integrity bounded context) ----
# Never put a live Razorpay key pair here. Test Mode credentials only.
INTEGRITY_STALENESS_THRESHOLD=15m
INTEGRITY_DEFAULT_CURRENCY=INR
INTEGRITY_PAYLOAD_RETENTION_DAYS=30
INTEGRITY_MAX_PAYLOAD_BYTES=65536
# Leave false: while false, approving a money-moving recovery action is refused outright.
INTEGRITY_ALLOW_FINANCIAL_EXECUTION=false
INTEGRITY_BENCHMARK_DIR=benchmark/results
# Route (Razorpay transfers) is an account-level product and cannot be probed reliably.
# Assert it explicitly, otherwise transfer checks are suppressed as 'capability not enabled'.
RAZORPAY_ROUTE_ENABLED=false

# ---- MySQL verification suite (opt-in, disposable database) ----
# Unset, every MySql*Test is skipped rather than failing a local build, so a plain `mvn test` keeps
# running on H2 exactly as before.
# Point this at a THROWAWAY schema: Flyway migrates it from empty and Hibernate validates the result
# against the entity model. Do not point it at a database you care about.
#
#   INTEGRITY_MYSQL_URL="jdbc:mysql://localhost:3306/aegisx_mysqlverify?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true" \
#   INTEGRITY_MYSQL_USER=root INTEGRITY_MYSQL_PASS= \
#     ./mvnw test -Dtest='MySql*Test'
#
# Separate variable for the DIAGNOSTIC DDL generator only. It sets ddl-auto=create, which drops the
# tables it owns; sharing one variable with the read-only checks above would let a diagnostic run
# destroy the schema under a real test.
# INTEGRITY_MYSQL_DDL_URL=jdbc:mysql://localhost:3306/aegisx_hbddl?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true

# ---- Server / storage / OCR ----
# Backend HTTP port. Leave unset to use the default 8080.
# WARNING: application.yml reads this as ${PORT:8080}. An ambient PORT=0 makes Spring Boot bind
# a *random* free port, which looks like "started but not listening" (found in phase-three).
PORT=8080
# local is the working storage implementation; the S3 adapter is not implemented.
STORAGE_TYPE=local
APP_STORAGE_ROOT_PATH=./storage
# Needed only for scanned/image documents. Leave blank to run without Tesseract.
TESSERACT_PATH=
OCR_LANGUAGE=eng
# Override only for a proxy/mock; defaults to https://api.razorpay.com/v1
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
